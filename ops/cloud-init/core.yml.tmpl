#cloud-config
# Core: CouchDB 3.5 + dcmjs-org/dicomweb-server, both as native systemd services.

package_update: true
package_upgrade: false

packages:
  - curl
  - ca-certificates
  - gnupg
  - git
  - apt-transport-https

write_files:
  - path: /etc/apt/preferences.d/couchdb
    permissions: "0644"
    content: |
      Package: couchdb
      Pin: version ${couchdb_version}*
      Pin-Priority: 1001

  # Initial mode 0600 (root-only) — tightened to 0640 root:lnq in runcmd
  # once the lnq user has been created. The password is never world-readable.
  - path: /etc/lnq/dicomweb-server.env
    permissions: "0600"
    content: |
      # The password is URL-encoded by Terraform before substitution; raw
      # base64 passwords contain '/' and '=' which URL parsers misread as
      # path/query separators inside the userinfo section.
      #
      # NOTE: do NOT include a port in this URL. dcmjs-org/dicomweb-server
      # appends its own dbPort (default 5984), producing a doubled port
      # like ":5984:5984" that fails to parse and crashes the nano client.
      DB_SERVER=http://admin:${couchdb_admin_password_url}@127.0.0.1
      # dcmjs-org/dicomweb-server's config/index.js does
      #   require('./' + process.env.NODE_ENV)
      # and the upstream repo only ships config/development.js. Setting
      # NODE_ENV=production crashes with MODULE_NOT_FOUND. Stay on development
      # until a production config is contributed upstream.
      NODE_ENV=development
      PORT=5985

  - path: /etc/systemd/system/lnq-dicomweb.service
    permissions: "0644"
    content: |
      [Unit]
      Description=LNQ dicomweb-server (dcmjs-org)
      After=network-online.target couchdb.service
      Wants=network-online.target
      Requires=couchdb.service

      [Service]
      Type=simple
      User=lnq
      Group=lnq
      WorkingDirectory=/opt/lnq/dicomweb-server
      EnvironmentFile=/etc/lnq/dicomweb-server.env
      ExecStart=/usr/bin/npm start
      Restart=on-failure
      RestartSec=5
      LimitNOFILE=65536

      [Install]
      WantedBy=multi-user.target

runcmd:
  # --- CouchDB from the Apache repo --------------------------------------
  - install -d -m 0755 /etc/apt/keyrings
  - curl -fsSL https://couchdb.apache.org/repo/keys.asc | gpg --dearmor -o /etc/apt/keyrings/couchdb-archive-keyring.gpg
  - |
    . /etc/os-release
    echo "deb [signed-by=/etc/apt/keyrings/couchdb-archive-keyring.gpg] https://apache.jfrog.io/artifactory/couchdb-deb/ $${VERSION_CODENAME} main" \
      > /etc/apt/sources.list.d/couchdb.list

  - |
    cat <<EOF | debconf-set-selections
    couchdb couchdb/mode select standalone
    couchdb couchdb/bindaddress string 0.0.0.0
    couchdb couchdb/cookie string $(openssl rand -hex 16)
    couchdb couchdb/adminpass password ${couchdb_admin_password}
    couchdb couchdb/adminpass_again password ${couchdb_admin_password}
    EOF

  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y couchdb

  # CouchDB config overlay — written after the package install creates
  # /etc/couchdb/local.d/. Restarting picks it up.
  - |
    cat > /etc/couchdb/local.d/10-lnq.ini <<'EOF'
    [couchdb]
    single_node = true

    [chttpd]
    bind_address = 0.0.0.0
    port = 5984

    [httpd]
    enable_cors = true

    [cors]
    origins = *
    credentials = true
    methods = GET,POST,PUT,DELETE,OPTIONS
    headers = accept,authorization,content-type,origin,referer,x-couchdb-www-authenticate
    EOF
  - chown couchdb:couchdb /etc/couchdb/local.d/10-lnq.ini
  - chmod 0640 /etc/couchdb/local.d/10-lnq.ini
  - systemctl restart couchdb

  # --- Node.js 20 from NodeSource ----------------------------------------
  - curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  - apt-get install -y nodejs

  # --- lnq service user + dicomweb-server --------------------------------
  - getent group lnq >/dev/null || groupadd -r lnq
  - id -u lnq >/dev/null 2>&1 || useradd -r -g lnq -d /opt/lnq -s /usr/sbin/nologin lnq

  # Tighten env file ownership/perms now that lnq exists.
  - chown root:lnq /etc/lnq/dicomweb-server.env
  - chmod 0640 /etc/lnq/dicomweb-server.env

  - install -d -o lnq -g lnq /opt/lnq
  # Clone the default branch first, then checkout whatever ref is requested.
  # Works for branches, tags, and commit SHAs, and avoids the master/main
  # default-branch surprise that would otherwise be a silent failure.
  - git clone https://github.com/dcmjs-org/dicomweb-server.git /opt/lnq/dicomweb-server
  - git -C /opt/lnq/dicomweb-server checkout ${dicomweb_server_ref}
  - chown -R lnq:lnq /opt/lnq/dicomweb-server
  - sudo -u lnq -H bash -lc 'cd /opt/lnq/dicomweb-server && npm ci --omit=dev'

  - systemctl daemon-reload
  - systemctl enable --now lnq-dicomweb.service

final_message: "lnq-core ready; CouchDB on 5984, dicomweb-server on 5985"
