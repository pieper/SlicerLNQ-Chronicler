#cloud-config
# SlicerLNQ Chronicle: CouchDB + dcmjs-org/dicomweb-server + Caddy on a single
# Js2 instance. All native systemd, all services on the same host.
#
# Variables substituted by bin/chronicle.sh via envsubst (limited list):
#   ${DOMAIN_NAME}, ${LETSENCRYPT_EMAIL}, ${COUCHDB_ADMIN_PASSWORD},
#   ${DICOMWEB_REF}
#
# Other shell substitutions inside heredocs are escaped as $$VAR (templatefile-
# style) — envsubst leaves them alone.

package_update: true
package_upgrade: false

packages:
  - curl
  - ca-certificates
  - gnupg
  - git
  - apt-transport-https
  - debian-keyring
  - debian-archive-keyring

write_files:
  - path: /etc/lnq/dicomweb-server.env
    permissions: "0600"
    content: |
      # CouchDB on the same host; password must be URL-safe (use openssl rand -hex).
      DB_SERVER=http://admin:${COUCHDB_ADMIN_PASSWORD}@127.0.0.1
      NODE_ENV=development
      PORT=5985

  - path: /etc/systemd/system/lnq-dicomweb.service
    permissions: "0644"
    content: |
      [Unit]
      Description=LNQ dicomweb-server (dcmjs-org)
      After=network-online.target couchdb.service
      Wants=network-online.target
      Requires=couchdb.service

      [Service]
      Type=simple
      User=lnq
      Group=lnq
      WorkingDirectory=/opt/lnq/dicomweb-server
      EnvironmentFile=/etc/lnq/dicomweb-server.env
      ExecStart=/usr/bin/npm start
      Restart=on-failure
      RestartSec=5
      LimitNOFILE=65536

      [Install]
      WantedBy=multi-user.target

runcmd:
  # --- CouchDB from Apache repo --------------------------------------
  - install -d -m 0755 /etc/apt/keyrings
  - curl -fsSL https://couchdb.apache.org/repo/keys.asc | gpg --dearmor -o /etc/apt/keyrings/couchdb-archive-keyring.gpg
  - |
    . /etc/os-release
    echo "deb [signed-by=/etc/apt/keyrings/couchdb-archive-keyring.gpg] https://apache.jfrog.io/artifactory/couchdb-deb/ $${VERSION_CODENAME} main" \
      > /etc/apt/sources.list.d/couchdb.list

  - |
    cat <<EOF | debconf-set-selections
    couchdb couchdb/mode select standalone
    couchdb couchdb/bindaddress string 127.0.0.1
    couchdb couchdb/cookie string $$(openssl rand -hex 16)
    couchdb couchdb/adminpass password ${COUCHDB_ADMIN_PASSWORD}
    couchdb couchdb/adminpass_again password ${COUCHDB_ADMIN_PASSWORD}
    EOF

  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y couchdb

  # CouchDB config overlay (CORS for browser clients).
  # bind_address stays 127.0.0.1 — Caddy proxies from same host.
  - |
    cat > /etc/couchdb/local.d/10-lnq.ini <<'EOF'
    [couchdb]
    single_node = true

    [chttpd]
    bind_address = 127.0.0.1
    port = 5984

    [httpd]
    enable_cors = true

    [cors]
    origins = *
    credentials = true
    methods = GET,POST,PUT,DELETE,OPTIONS
    headers = accept,authorization,content-type,origin,referer
    EOF
  - chown couchdb:couchdb /etc/couchdb/local.d/10-lnq.ini
  - chmod 0640 /etc/couchdb/local.d/10-lnq.ini
  - systemctl restart couchdb

  # --- Node 20 from NodeSource ---------------------------------------
  - curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
  - apt-get install -y nodejs

  # --- dicomweb-server -----------------------------------------------
  - getent group lnq >/dev/null || groupadd -r lnq
  - id -u lnq >/dev/null 2>&1 || useradd -r -g lnq -d /opt/lnq -s /usr/sbin/nologin lnq
  - chown root:lnq /etc/lnq/dicomweb-server.env
  - chmod 0640 /etc/lnq/dicomweb-server.env
  - install -d -o lnq -g lnq /opt/lnq
  - git clone https://github.com/dcmjs-org/dicomweb-server.git /opt/lnq/dicomweb-server
  - git -C /opt/lnq/dicomweb-server checkout ${DICOMWEB_REF}
  - chown -R lnq:lnq /opt/lnq/dicomweb-server
  - sudo -u lnq -H bash -lc 'cd /opt/lnq/dicomweb-server && npm install --omit=dev'

  # --- Caddy from Cloudsmith -----------------------------------------
  - curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/gpg.key | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  - curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt -o /etc/apt/sources.list.d/caddy-stable.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y caddy

  # Write our Caddyfile AFTER install (avoids dpkg conffile prompt that
  # otherwise aborts the postinst and leaves caddy with no user/binary).
  - |
    cat > /etc/caddy/Caddyfile <<'CADDYEOF'
    {
      email ${LETSENCRYPT_EMAIL}
    }

    ${DOMAIN_NAME} {
      encode gzip

      respond /health 200 {
        body "ok"
      }

      handle_path /dicomweb/* {
        reverse_proxy 127.0.0.1:5985
      }

      reverse_proxy 127.0.0.1:5984

      log {
        output file /var/log/caddy/access.log {
          roll_size 10mb
          roll_keep 5
        }
        format json
      }
    }
    CADDYEOF

  # Caddy package postinst pre-creates /var/log/caddy/access.log as root,
  # which then EACCES's caddy. Fix ownership recursively.
  - install -d -o caddy -g caddy /var/log/caddy
  - chown -R caddy:caddy /var/log/caddy

  # --- start everything ----------------------------------------------
  - systemctl daemon-reload
  - systemctl enable --now lnq-dicomweb.service
  - systemctl reload caddy

final_message: "lnq-chronicle ready; CouchDB + dicomweb-server + Caddy on ${DOMAIN_NAME}"
