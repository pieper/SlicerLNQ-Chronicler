#cloud-config
# Doorman: Caddy as TLS terminator + reverse proxy. Native systemd, no Docker.
# Watchman service for activity-driven shelve/unshelve lands in a later commit.

package_update: true
package_upgrade: false

packages:
  - curl
  - ca-certificates
  - gnupg
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https

write_files:
  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    defer: true
    content: |
      {
        email ${letsencrypt_email}
      }

      ${domain_name} {
        encode gzip

        # CouchDB API surface lives at the root for now.
        # /_utils (Fauxton) is included; protected by CouchDB admin auth.
        reverse_proxy ${core_internal_ip}:5984

        # DICOMweb endpoints are mounted under /dicomweb/.
        # The dcmjs-org server expects to receive these paths verbatim;
        # strip_prefix is intentionally not used.
        handle_path /dicomweb/* {
          reverse_proxy ${core_internal_ip}:5985
        }

        # Health check used by external monitors. Never proxied; the watchman
        # (added in a later commit) recognizes this path and excludes it from
        # the activity signal.
        respond /health/doorman 200 {
          body "ok"
        }

        log {
          output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
          }
          format json
        }
      }

runcmd:
  # --- Caddy from Cloudsmith repo (the official packaging path) ----------
  - install -d -m 0755 /etc/apt/keyrings
  - curl -fsSL "https://dl.cloudsmith.io/public/caddy/stable/gpg.key" | gpg --dearmor -o /etc/apt/keyrings/caddy-stable-archive-keyring.gpg
  - curl -fsSL "https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt" | tee /etc/apt/sources.list.d/caddy-stable.list
  - sed -i 's|https://dl.cloudsmith.io|[signed-by=/etc/apt/keyrings/caddy-stable-archive-keyring.gpg] https://dl.cloudsmith.io|' /etc/apt/sources.list.d/caddy-stable.list

  - apt-get update
  - apt-get install -y caddy

  - install -d -o caddy -g caddy /var/log/caddy
  - systemctl enable --now caddy
  - systemctl reload caddy

final_message: "doorman ready; Caddy serving ${domain_name}"
