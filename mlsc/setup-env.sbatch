#!/usr/bin/env bash
# setup-env.sbatch — build the venv on /vast/lnq and fetch model weights.
# Runs on the basic partition (pip installs are too heavy for the login node).
# Idempotent: re-run after changing PYTHON / TORCH_INDEX / LNQ_SEGMENTER_SPEC.
#SBATCH --job-name=lnq-setup-env
#SBATCH --time=0-03:00:00
#SBATCH --mem=16G
#SBATCH --cpus-per-task=4
set -euo pipefail
: "${ROOT:?}" "${ENV:?}" "${MODELS_CACHE:?}" "${NNUNET_BASE:?}" "${TORCH_INDEX:?}" "${LNQ_SEGMENTER_SPEC:?}" "${MODELS:?}"
PY=${PYTHON:-uv:3.11}
export TMPDIR=${TMPDIR:-/tmp}
export PIP_CACHE_DIR="$TMPDIR/pip-cache"          # keep the home quota out of it
echo "== $(date -u) host=$(hostname) PYTHON=$PY env=$ENV"

# The MLSC nodes are heterogeneous (Rocky 8 / Rocky 9 / Ubuntu 24.04 with
# different system pythons and glibc), so a venv tied to /usr/bin/pythonX.Y
# only runs on some partitions. Default: a relocatable CPython managed by uv
# under $ROOT/python, which every node can execute. Set PYTHON=/path/to/python3
# in mlsc.conf to use a system interpreter instead.
case "$PY" in
  uv:*)
    ver=${PY#uv:}
    UV="$ROOT/bin/uv"
    export UV_PYTHON_INSTALL_DIR="$ROOT/python" UV_CACHE_DIR="$TMPDIR/uv-cache"
    if [ ! -x "$UV" ]; then
      echo "== installing uv → $ROOT/bin"
      curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$ROOT/bin" UV_NO_MODIFY_PATH=1 sh
    fi
    "$UV" python install "$ver"
    if [ ! -x "$ENV/bin/python" ]; then
      "$UV" venv --seed --python "$ver" "$ENV"     # --seed: include pip for the steps below
    fi
    ;;
  *)
    if [ ! -x "$ENV/bin/python" ]; then
      "$PY" -m venv "$ENV"
    fi
    ;;
esac
echo "== venv python: $("$ENV/bin/python" --version 2>&1) ($(readlink -f "$ENV/bin/python"))"
"$ENV/bin/pip" install --upgrade pip wheel
"$ENV/bin/pip" install --extra-index-url "$TORCH_INDEX" torch torchvision
"$ENV/bin/pip" install nnunetv2 SimpleITK pydicom numpy matplotlib
# Decoders for compressed transfer syntaxes (only the pydicom fallback path
# needs them; SimpleITK/GDCM handles the main path). Non-fatal.
"$ENV/bin/pip" install python-gdcm pylibjpeg pylibjpeg-libjpeg pylibjpeg-openjpeg \
  || echo "WARN: optional pixel decoders failed to install"
"$ENV/bin/pip" install --upgrade "$LNQ_SEGMENTER_SPEC"
"$ENV/bin/pip" install "huggingface_hub[cli]" nibabel

mkdir -p "$MODELS_CACHE" "$NNUNET_BASE"/raw "$NNUNET_BASE"/preprocessed "$NNUNET_BASE"/results
cat > "$ENV/activate.sh" <<ACT
# generated by setup-env.sbatch — source this in every job
export PATH="$ENV/bin:\$PATH"
export LNQ_SEGMENTER_CACHE="$MODELS_CACHE"
export MODELS_CACHE="$MODELS_CACHE"
export LNQ_NNUNET_BASE="$NNUNET_BASE"
export HF_HOME="\${TMPDIR:-/tmp}/hf-\$USER"
export nnUNet_raw="$NNUNET_BASE/raw"
export nnUNet_preprocessed="$NNUNET_BASE/preprocessed"
export nnUNet_results="$NNUNET_BASE/results"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="\${TMPDIR:-/tmp}/mpl-\$USER"
ACT
# shellcheck disable=SC1090
. "$ENV/activate.sh"

MLSC_DIR=${MLSC_DIR:-$(cd "$(dirname "$0")" && pwd)}
for m in $MODELS; do
  echo "== weights: $m"
  ext=$(python - "$m" <<PY
import json, sys
spec = json.load(open("$MLSC_DIR/models.json")).get(sys.argv[1])
print(f"{spec['hf_repo']} {spec['folder']} {spec.get('folds', ['all'])[0]} {spec.get('checkpoint', 'checkpoint_final.pth')}" if spec else "")
PY
)
  if [ -n "$ext" ]; then
    set -- $ext
    repo=$1; folder="$MODELS_CACHE/$2"; fold=$3; ck=$4
    if [ ! -f "$folder/fold_$fold/$ck" ]; then
      hf download "$repo" --local-dir "$folder"
    fi
    for f in dataset.json plans.json "fold_$fold/$ck"; do
      [ -f "$folder/$f" ] || { echo "ERROR: $folder/$f missing after download" >&2; exit 1; }
    done
    echo "   ok: $folder"
  else
    lnq-segmenter download "$m" --quiet
  fi
done
echo "== installed:"
lnq-segmenter list
ls -d "$MODELS_CACHE"/*/ 2>/dev/null
python -c "import torch, nnunetv2, SimpleITK, pydicom; print('torch', torch.__version__, 'cuda-build', torch.version.cuda, '| SimpleITK', SimpleITK.__version__, '| pydicom', pydicom.__version__)"
echo "== done $(date -u)"
