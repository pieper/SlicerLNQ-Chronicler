#!/usr/bin/env bash
# setup-env.sbatch — build the venv on /vast/lnq and fetch model weights.
# Runs on the basic partition (pip installs are too heavy for the login node).
# Idempotent: re-run after changing PYTHON / TORCH_INDEX / LNQ_SEGMENTER_SPEC.
#SBATCH --job-name=lnq-setup-env
#SBATCH --time=0-03:00:00
#SBATCH --mem=16G
#SBATCH --cpus-per-task=4
set -euo pipefail
: "${ENV:?}" "${MODELS_CACHE:?}" "${NNUNET_BASE:?}" "${TORCH_INDEX:?}" "${LNQ_SEGMENTER_SPEC:?}" "${MODELS:?}"
PY=${PYTHON:-python3}
export TMPDIR=${TMPDIR:-/tmp}
export PIP_CACHE_DIR="$TMPDIR/pip-cache"          # keep the home quota out of it
echo "== $(date -u) host=$(hostname) python=$($PY --version 2>&1) env=$ENV"

if [ ! -x "$ENV/bin/python" ]; then
  "$PY" -m venv "$ENV"
fi
"$ENV/bin/pip" install --upgrade pip wheel
"$ENV/bin/pip" install --extra-index-url "$TORCH_INDEX" torch torchvision
"$ENV/bin/pip" install nnunetv2 SimpleITK pydicom numpy matplotlib
# Decoders for compressed transfer syntaxes (only the pydicom fallback path
# needs them; SimpleITK/GDCM handles the main path). Non-fatal.
"$ENV/bin/pip" install python-gdcm pylibjpeg pylibjpeg-libjpeg pylibjpeg-openjpeg \
  || echo "WARN: optional pixel decoders failed to install"
"$ENV/bin/pip" install --upgrade "$LNQ_SEGMENTER_SPEC"

mkdir -p "$MODELS_CACHE" "$NNUNET_BASE"/raw "$NNUNET_BASE"/preprocessed "$NNUNET_BASE"/results
cat > "$ENV/activate.sh" <<ACT
# generated by setup-env.sbatch — source this in every job
export PATH="$ENV/bin:\$PATH"
export LNQ_SEGMENTER_CACHE="$MODELS_CACHE"
export LNQ_NNUNET_BASE="$NNUNET_BASE"
export nnUNet_raw="$NNUNET_BASE/raw"
export nnUNet_preprocessed="$NNUNET_BASE/preprocessed"
export nnUNet_results="$NNUNET_BASE/results"
export PYTHONUNBUFFERED=1
export MPLCONFIGDIR="\${TMPDIR:-/tmp}/mpl-\$USER"
ACT
# shellcheck disable=SC1090
. "$ENV/activate.sh"

for m in $MODELS; do
  echo "== weights: $m"
  lnq-segmenter download "$m" --quiet
done
echo "== installed:"
lnq-segmenter list
python -c "import torch, nnunetv2, SimpleITK, pydicom; print('torch', torch.__version__, 'cuda-build', torch.version.cuda, '| SimpleITK', SimpleITK.__version__, '| pydicom', pydicom.__version__)"
echo "== done $(date -u)"
